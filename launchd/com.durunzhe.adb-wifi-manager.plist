<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.durunzhe.adb-wifi-manager</string>

    <key>ProgramArguments</key>
    <array>
        <string>__APP_DIR__/bin/adb-wifi.sh</string>
        <string>_daemon</string>
    </array>

    <!-- 登录时启动，崩溃后自动重启 -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/launchd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- adb 不在 launchd 默认 PATH 中，显式指定 -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:__ADB_DIR__</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
